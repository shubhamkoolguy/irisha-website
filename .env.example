# Configure in Cloudflare Pages Settings > Variables and Secrets.
# Never add real secrets to git or the public admin config.
SITE_URL=https://irisha.co.in
GITHUB_REPO=shubhamkoolguy/irisha-website
GITHUB_CLIENT_ID=YOUR_OAUTH_APP_CLIENT_ID
GITHUB_CLIENT_SECRET=SET_AS_A_CLOUDFLARE_SECRET

# Contact bot protection: server-side runtime settings (never public CMS content).
RECAPTCHA_SITE_KEY=YOUR_GOOGLE_RECAPTCHA_V2_CHECKBOX_SITE_KEY
RECAPTCHA_SECRET_KEY=SET_AS_A_SECRET
RECAPTCHA_ALLOWED_HOSTNAMES=irisha.co.in,www.irisha.co.in,irisha-concierge.shubhamkoolguy.chatgpt.site
CONTACT_WHATSAPP=SET_INTERNATIONAL_DIGITS_AS_A_SECRET
